# ---------- 必填 ----------

# 目標 Claude Code Channel 絕對路徑（含 .claude/, tasks/, memory/）
CHANNEL_PATH=/path/to/your/claude-code-channel

# Google OAuth Client ID（在 Google Cloud Console 建立 OAuth 2.0 Web Application
# 後從「Client ID」欄位複製。Authorized JavaScript origins 要填 TUNNEL_HOSTNAME
# 加上 http://localhost:5173 做開發）
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# 唯一允許登入的 Email（必須與 Google 帳號完全一致）
# ⚠️ Single-operator design：本系統假設只有一個 email。改 multi-user 前必須在
# code 層補上 resource-owner 檢查（詳見 auth-gate.js 的註解），否則任一 user
# 可看其他 user 的 terminal log / 改 SOUL.md / 殺其他 PTY session。
ALLOWED_EMAIL=you@example.com

# 自家 Session JWT 簽章密鑰，請用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成
SESSION_SECRET=replace_me_with_a_strong_64_char_hex_secret

# ---------- 可選 ----------

# Express 服務 port
PORT=3000

# 綁定位址（預設 127.0.0.1）。對外只走 Cloudflare tunnel，不要改成 0.0.0.0
# HOST=127.0.0.1

# Cloudflare tunnel 對外 hostname。程式目前不讀取；安裝手冊（docs/agent-install.md）步驟 0 用它做外部檢查
TUNNEL_HOSTNAME=codd.example.com

# Node 環境（production 會啟用 Secure cookie、CSP 嚴格模式等）
NODE_ENV=production

# SQLite 檔案位置（**絕對路徑**，MCP server 也會讀取同一個路徑）
KANBAN_DB_PATH=/path/to/2026-remote-claude-code-manager/apps/server/data/kanban.db

# Hook 寫 session status 的目錄（multi-session：每個 session 一個 file
# <session_id>.json）。channel CLI 會自動把這個值寫進 channel hook command 的 env。
# 舊版 STATUS_FILE_PATH 仍向下相容（會取 dirname 當作目錄）。
STATUS_DIR_PATH=/Users/you/.claude/codd-status

# Session 有效期（天）
SESSION_TTL_DAYS=7

# ---------- 帳號切換（側欄用量面板，皆選填）----------
# server 由 launchd 啟動時 PATH 常常不完整。沒設的話依序找：PATH → ~/.local/bin →
# /opt/homebrew/bin → /usr/local/bin（Codex 另外試 Codex.app / ChatGPT.app 內附的 CLI）。
# 有設就只用這個路徑，指錯不會退回 PATH 上的其他版本。

# claude-swap（cswap）執行檔：Claude 帳號清單、各帳號週用量與切換
# CSWAP_BIN=/Users/you/.local/bin/cswap

# Codex CLI 執行檔：用 `codex app-server` 讀 Codex 剩餘用量
# CODEX_BIN=/Users/you/.local/bin/codex

# Codex 設定目錄（和 codex CLI 同一個變數；預設 ~/.codex）。切換 Codex 帳號會改寫這裡的 auth.json
# （改寫前備份到帳號庫的 .backup/，只留最近 5 份）。憑證存在 keyring 時只能看用量、不能切換。
# CODEX_HOME=/Users/you/.codex

# Codex 帳號庫：每個已加入的帳號一個 JSON（內含該帳號的 auth.json，目錄 0700、檔案 0600）
# 預設 ~/.fancy-codd/codex-accounts
# CODD_CODEX_VAULT=/Users/you/.fancy-codd/codex-accounts

# ---------- 進階（通常不用設）----------

# 前端用的 Google Client ID，build 時寫進前端；沒設就用 GOOGLE_CLIENT_ID。Vite 只讀這份根目錄 .env
# ⚠️ 通常不要設：server 只認 GOOGLE_CLIENT_ID 為 audience，這裡設成不同值時登入一律 401 Wrong recipient
# VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Claude Code 設定目錄（Claude Code 本身的變數，預設 ~/.claude）。會傳給 app 開的 session，
# npm run setup 與 /setup 也會改裝到 $CLAUDE_CONFIG_DIR/settings.json
# CLAUDE_CONFIG_DIR=/Users/you/.claude

# 直接指定 npm run setup 與 /setup 要修改的 settings.json（優先於 CLAUDE_CONFIG_DIR）
# CODD_CLAUDE_SETTINGS_PATH=/Users/you/.claude/settings.json

# 讀 Claude transcript（<目錄>/projects）用的目錄，預設 $CLAUDE_CONFIG_DIR 或 ~/.claude
# CODD_CLAUDE_HOME=/Users/you/.claude
